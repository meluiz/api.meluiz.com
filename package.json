{
  "$schema": "https://json.schemastore.org/package.json",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "lint": "biome lint --write",
    "format": "biome format --write"
  },
  "imports": {
    "#controller/*": "./src/controllers/*.js",
    "#middleware/*": "./src/middlewares/*.js",
    "#plugin/*": "./src/plugins/*.js",
    "#routes/*": "./src/routes/*.js",
    "#util/*": "./src/utils/*.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@motiro/types": "^0.1.1",
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "picocolors": "^1.1.1"
  },
  "dependencies": {
    "@motiro/string": "^0.1.3",
    "envin": "^1.2.0",
    "hono": "^4.13.7",
    "hono-rate-limiter": "^0.5.3",
    "zod": "^4.5.4"
  }
}
